<launch>

  <!-- Paths -->
  <let name="urdf_path"
       value="$(find-pkg-share my_robot_description)/urdf/my_robotic_arm.urdf.xacro"/>
  <let name="rviz_config_path"
       value="$(find-pkg-share my_robot_bringup)/config/my_robot_moveit.rviz"/>

  <!-- 1. Robot State Publisher -->
  <node pkg="robot_state_publisher" exec="robot_state_publisher">
    <param name="robot_description"
           value="$(command 'xacro $(var urdf_path)')"/>
  </node>

  <!-- 2. ROS2 Control - Controller Manager -->
  <node pkg="controller_manager" exec="ros2_control_node" output="screen">
    <param name="robot_description"
           value="$(command 'xacro $(var urdf_path)')"/>
    <param from="$(find-pkg-share my_robot_bringup)/config/ros2_controllers.yaml"/>
  </node>

  <!-- 3. Spawn Controllers -->
  <node pkg="controller_manager" exec="spawner"
        args="joint_state_broadcaster"/>
  <node pkg="controller_manager" exec="spawner"
        args="arm_controller"/>
  <node pkg="controller_manager" exec="spawner"
        args="gripper_controller"/>

  <!-- 4. MoveIt2 Move Group -->
  <include file="$(find-pkg-share my_robot_moveit_config)/launch/move_group.launch.py"/>

  <!-- 5. RViz2 -->
  <node pkg="rviz2" exec="rviz2" output="screen"
        args="-d $(var rviz_config_path)"/>

</launch>

