<?xml version="1.0" encoding="UTF-8"?>
<robot name="my_robotic_arm">
    <group name="arm">
        <joint name="virtusl_joint"/>
        <joint name="base_shoulder_joint"/>
        <joint name="shoulder_arm_joint"/>
        <joint name="arm_elbow_joint"/>
        <joint name="elbow_forearm_joint"/>
        <joint name="forearm_wrist_joint"/>
        <joint name="wrist_hand_joint"/>
        <joint name="hand_tool_joint"/>
    </group>
    <group name="gripper">
        <joint name="gripper_base_joint"/>
        <joint name="gripper_left_finger_joint"/>
        <joint name="gripper_right_finger_joint"/>
    </group>
    <group_state name="home" group="arm">
        <joint name="arm_elbow_joint" value="0"/>
        <joint name="base_shoulder_joint" value="0"/>
        <joint name="elbow_forearm_joint" value="0"/>
        <joint name="forearm_wrist_joint" value="0"/>
        <joint name="shoulder_arm_joint" value="0"/>
        <joint name="wrist_hand_joint" value="0"/>
    </group_state>
    <group_state name="pose_1" group="arm">
        <joint name="arm_elbow_joint" value="0.7873"/>
        <joint name="base_shoulder_joint" value="0.8848"/>
        <joint name="elbow_forearm_joint" value="-1.3358"/>
        <joint name="forearm_wrist_joint" value="0.2515"/>
        <joint name="shoulder_arm_joint" value="0.732"/>
        <joint name="wrist_hand_joint" value="-1.0587"/>
    </group_state>
    <group_state name="pose_2" group="arm">
        <joint name="arm_elbow_joint" value="0.8011"/>
        <joint name="base_shoulder_joint" value="-1.2317"/>
        <joint name="elbow_forearm_joint" value="-0.6766"/>
        <joint name="forearm_wrist_joint" value="-0.5985"/>
        <joint name="shoulder_arm_joint" value="0.9254"/>
        <joint name="wrist_hand_joint" value="-1.3406"/>
    </group_state>
    <group_state name="gripper_open" group="gripper">
        <joint name="gripper_left_finger_joint" value="0"/>
    </group_state>
    <group_state name="gripper_closed" group="gripper">
        <joint name="gripper_left_finger_joint" value="0.06"/>
    </group_state>
    <group_state name="gripper_half_closed" group="gripper">
        <joint name="gripper_left_finger_joint" value="0.0401"/>
    </group_state>
    <end_effector name="gripper" parent_link="tool_link" group="gripper" parent_group="arm"/>
    <virtual_joint name="virtusl_joint" type="fixed" parent_frame="world" child_link="base_link"/>
    <disable_collisions link1="arm_link" link2="base_link" reason="Never"/>
    <disable_collisions link1="arm_link" link2="elbow_link" reason="Adjacent"/>
    <disable_collisions link1="arm_link" link2="gripper_base_link" reason="Never"/>
    <disable_collisions link1="arm_link" link2="gripper_left_finger_link" reason="Never"/>
    <disable_collisions link1="arm_link" link2="gripper_right_finger_link" reason="Never"/>
    <disable_collisions link1="arm_link" link2="hand_link" reason="Never"/>
    <disable_collisions link1="arm_link" link2="shoulder_link" reason="Adjacent"/>
    <disable_collisions link1="arm_link" link2="wrist_link" reason="Never"/>
    <disable_collisions link1="base_link" link2="shoulder_link" reason="Adjacent"/>
    <disable_collisions link1="elbow_link" link2="forearm_link" reason="Adjacent"/>
    <disable_collisions link1="elbow_link" link2="gripper_base_link" reason="Never"/>
    <disable_collisions link1="elbow_link" link2="gripper_left_finger_link" reason="Never"/>
    <disable_collisions link1="elbow_link" link2="gripper_right_finger_link" reason="Never"/>
    <disable_collisions link1="elbow_link" link2="hand_link" reason="Never"/>
    <disable_collisions link1="elbow_link" link2="shoulder_link" reason="Never"/>
    <disable_collisions link1="elbow_link" link2="wrist_link" reason="Never"/>
    <disable_collisions link1="forearm_link" link2="gripper_base_link" reason="Never"/>
    <disable_collisions link1="forearm_link" link2="gripper_left_finger_link" reason="Never"/>
    <disable_collisions link1="forearm_link" link2="gripper_right_finger_link" reason="Never"/>
    <disable_collisions link1="forearm_link" link2="hand_link" reason="Never"/>
    <disable_collisions link1="forearm_link" link2="wrist_link" reason="Adjacent"/>
    <disable_collisions link1="gripper_base_link" link2="gripper_left_finger_link" reason="Adjacent"/>
    <disable_collisions link1="gripper_base_link" link2="gripper_right_finger_link" reason="Adjacent"/>
    <disable_collisions link1="gripper_base_link" link2="hand_link" reason="Adjacent"/>
    <disable_collisions link1="gripper_base_link" link2="wrist_link" reason="Never"/>
    <disable_collisions link1="gripper_left_finger_link" link2="gripper_right_finger_link" reason="Never"/>
    <disable_collisions link1="gripper_left_finger_link" link2="hand_link" reason="Never"/>
    <disable_collisions link1="gripper_left_finger_link" link2="wrist_link" reason="Never"/>
    <disable_collisions link1="gripper_right_finger_link" link2="hand_link" reason="Never"/>
    <disable_collisions link1="gripper_right_finger_link" link2="wrist_link" reason="Never"/>
    <disable_collisions link1="hand_link" link2="wrist_link" reason="Adjacent"/>
</robot>
